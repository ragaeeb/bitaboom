{
    "name": "bitaboom",
    "description": "Use string utils library to format Arabic and English translations.",
    "version": "2.0.0",
    "author": "Ragaeeb Haq",
    "license": "MIT",
    "private": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "source": "src/index.ts",
    "type": "module",
    "homepage": "https://github.com/ragaeeb/bitaboom",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ragaeeb/bitaboom.git"
    },
    "bugs": {
        "url": "https://github.com/ragaeeb/bitaboom/issues"
    },
    "engines": {
        "bun": ">=1.2.21",
        "node": ">=22.0.0"
    },
    "files": [
        "dist/**"
    ],
    "scripts": {
        "build": "tsdown",
        "lint": "biome check --write .",
        "format": "biome format --write .",
        "lint:ci": "biome ci"
    },
    "keywords": [
        "formatting",
        "arabic"
    ],
    "devDependencies": {
        "@biomejs/biome": "^2.3.5",
        "@types/bun": "^1.3.2",
        "@types/node": "^24.10.1",
        "semantic-release": "^25.0.2",
        "tsdown": "^0.16.3",
        "typescript": "^5.9.3"
    }
}
