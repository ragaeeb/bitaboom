{
    "name": "bitaboom",
    "description": "Use string utils library to format Arabic and English translations.",
    "version": "1.5.0",
    "author": "Ragaeeb Haq",
    "license": "MIT",
    "private": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "source": "src/index.ts",
    "type": "module",
    "homepage": "https://github.com/ragaeeb/bitaboom",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ragaeeb/bitaboom.git"
    },
    "bugs": {
        "url": "https://github.com/ragaeeb/bitaboom/issues"
    },
    "engines": {
        "bun": ">=1.2.21",
        "node": ">=22.0.0"
    },
    "files": [
        "dist/index.js",
        "dist/index.js.map",
        "dist/*.d.ts"
    ],
    "scripts": {
        "build": "tsup",
        "lint": "biome check --write .",
        "format": "biome format --write .",
        "lint:ci": "biome ci"
    },
    "keywords": [
        "formatting",
        "arabic"
    ],
    "devDependencies": {
        "@biomejs/biome": "^2.2.4",
        "@types/bun": "^1.2.21",
        "@types/node": "^24.3.1",
        "semantic-release": "^24.2.8",
        "tsup": "^8.5.0"
    }
}
