{
    "name": "bitaboom",
    "description": "Use string utils library to format Arabic and English translations.",
    "version": "2.5.1",
    "author": "Ragaeeb Haq",
    "license": "MIT",
    "private": false,
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "source": "src/index.ts",
    "type": "module",
    "homepage": "https://github.com/ragaeeb/bitaboom",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ragaeeb/bitaboom.git"
    },
    "bugs": {
        "url": "https://github.com/ragaeeb/bitaboom/issues"
    },
    "engines": {
        "bun": ">=1.4.2",
        "node": ">=26.0.0"
    },
    "packageManager": "bun@1.4.2",
    "files": [
        "dist/**"
    ],
    "scripts": {
        "build": "tsdown",
        "lint": "biome check --write .",
        "format": "biome format --write .",
        "lint:ci": "biome ci"
    },
    "keywords": [
        "formatting",
        "arabic"
    ],
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "@types/bun": "^1.4.2",
        "@types/node": "^26.6.4",
        "semantic-release": "^25.0.9",
        "tsdown": "^0.23.0",
        "typescript": "^7.0.2"
    }
}
